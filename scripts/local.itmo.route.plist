<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.itmo.route</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/usr/local/sbin/itmo-route.sh</string>
  </array>
  <!-- Re-pin on load and every 30s, so the route survives FortiClient reconnects. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>StandardErrorPath</key>
  <string>/var/log/itmo-route.err</string>
</dict>
</plist>
