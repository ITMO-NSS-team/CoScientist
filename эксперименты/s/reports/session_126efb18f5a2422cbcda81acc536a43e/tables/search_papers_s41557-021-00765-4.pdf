ripps Research Institute","address":{"name":"Department of Chemistry, The Skaggs Institute for Chemical Biology, The Scripps Research Institute, La Jolla, USA","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Taka-Aki Ichu","affiliation":[{"name":"The Scripps Research Institute","address":{"name":"Department of Chemistry, The Skaggs Institute for Chemical Biology, The Scripps Research Institute, La Jolla, USA","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Michael R. Lazear","url":"http://orcid.org/0000-0001-5313-4262","affiliation":[{"name":"The Scripps Research Institute","address":{"name":"Department of Chemistry, The Skaggs Institute for Chemical Biology, The Scripps Research Institute, La Jolla, USA","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Yongfeng Tao","affiliation":[{"name":"The Scripps Research Institute","address":{"name":"Department of Chemistry, The Skaggs Institute for Chemical Biology, The Scripps Research Institute, La Jolla, USA","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Vincent M. Crowley","affiliation":[{"name":"The Scripps Research Institute","address":{"name":"Department of Chemistry, The Skaggs Institute for Chemical Biology, The Scripps Research Institute, La Jolla, USA","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Christopher W. am Ende","affiliation":[{"name":"Pfizer Worldwide Research and Development","address":{"name":"Medicine Design, Pfizer Worldwide Research and Development, Groton, USA","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Stephan M. Hacker","url":"http://orcid.org/0000-0001-5420-4824","affiliation":[{"name":"Technische Universität München","address":{"name":"Department of Chemistry, Technische Universität München, Garching, Germany","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Jordan Ho","affiliation":[{"na