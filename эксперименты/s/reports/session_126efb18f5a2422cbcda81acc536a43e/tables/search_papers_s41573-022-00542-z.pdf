of California, Berkeley, Berkeley, USA","@type":"PostalAddress"},"@type":"Organization"},{"name":"Novartis-Berkeley Center for Proteomics and Chemistry Technologies","address":{"name":"Novartis-Berkeley Center for Proteomics and Chemistry Technologies, Berkeley, USA","@type":"PostalAddress"},"@type":"Organization"},{"name":"Innovative Genomics Institute","address":{"name":"Innovative Genomics Institute, Berkeley, USA","@type":"PostalAddress"},"@type":"Organization"}],"@type":"Person"},{"name":"Daniel K. Nomura","url":"http://orcid.org/0000-0003-1614-8360","affiliation":[{"name":"University of California, Berkeley","address":{"name":"Department of Chemistry, University of California, Berkeley, Berkeley, USA","@type":"PostalAddress"},"@type":"Organization"},{"name":"Novartis-Berkeley Center for Proteomics and Chemistry Technologies","address":{"name":"Novartis-Berkeley Center for Proteomics and Chemistry Technologies, Berkeley, USA","@type":"PostalAddress"},"@type":"Organization"},{"name":"Innovative Genomics Institute","address":{"name":"Innovative Genomics Institute, Berkeley, USA","@type":"PostalAddress"},"@type":"Organization"}],"email":"dnomura@berkeley.edu","@type":"Person"}],"isAccessibleForFree":false,"hasPart":{"isAccessibleForFree":false,"cssSelector":".main-content","@type":"WebPageElement"},"@type":"ScholarlyArticle"},"@context":"https://schema.org","@type":"WebPage"}</script>




    
    
