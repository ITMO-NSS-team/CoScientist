USA","@type":"PostalAddress"},"@type":"Organization"},{"name":"Yale University","address":{"name":"Department of Pharmacology, Yale University, New Haven, USA","@type":"PostalAddress"},"@type":"Organization"},{"name":"Yale University","address":{"name":"Department of Chemistry, Yale University, New Haven, USA","@type":"PostalAddress"},"@type":"Organization"}],"email":"craig.crews@yale.edu","@type":"Person"}],"isAccessibleForFree":false,"hasPart":{"isAccessibleForFree":false,"cssSelector":".main-content","@type":"WebPageElement"},"@type":"ScholarlyArticle"},"@context":"https://schema.org","@type":"WebPage"}</script>




    
    
