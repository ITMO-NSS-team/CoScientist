# RDKit-only tools work inside this container without remote services.
# OCR and docking use the Chemistry service on the Windows host.
CHEM_SERVICES_HOST=host.docker.internal
CHEM_SERVICES_PORT=8005
CHEM_SERVICES_TIMEOUT=60
PROCESSED_IMG_STORAGE_PATH=/tmp/chemical_mcp_annotated

# Retrosynthesis, reaction classification and forward prediction use ASKCOS.
RETROSYNTHESIS_SERVICES_HOST=host.docker.internal
RETROSYNTHESIS_SERVICES_PORT=8001
RETROSYNTHESIS_REQUEST_TIMEOUT=60

CHEM_MCP_HOST=0.0.0.0
CHEM_MCP_PORT=7331
CHEM_MCP_PATH=/mcp

# S3 is required by tools that return images, HTML or generated files.
S3_ENDPOINT_URL=http://host.docker.internal:9000
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=
