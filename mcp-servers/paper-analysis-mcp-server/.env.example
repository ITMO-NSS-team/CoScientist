# Paper analysis requires an LLM/Vision endpoint. Leave all tokens empty until
# you provide credentials.
LLM__VISION_URL=
LLM__SERVICE_KEY=
OPENAI_API_KEY=
LLM__ALLOWED_PROVIDERS=[]

# Chroma, embedding, reranking and OpenChemIE may run on the Windows host.
STORAGE__CHROMA_STORAGE=
ROOT_DIR=

HOSTS_PORTS__CHROMA_HOST=host.docker.internal
HOSTS_PORTS__EMBEDDING_HOST=host.docker.internal
HOSTS_PORTS__RERANKER_HOST=host.docker.internal
HOSTS_PORTS__OPENCHEMIE_HOST=host.docker.internal
HOSTS_PORTS__CHROMA_PORT=9999
HOSTS_PORTS__EMBEDDING_PORT=9999
HOSTS_PORTS__RERANKER_PORT=9999
HOSTS_PORTS__OPENCHEMIE_PORT=8005

COLLECTIONS__SUMMARIES=
COLLECTIONS__TEXTS=
COLLECTIONS__IMAGES=

# S3 is required for uploaded-paper analysis.
S3__ENDPOINT_URL=http://host.docker.internal:9000
S3__ACCESS_KEY=
S3__SECRET_KEY=
S3__BUCKET_NAME=
