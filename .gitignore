# Credentials — live API keys, must never leave the machine
.env
.env.*
!.env.example

# Local agent/session config — machine-specific, never shared
.claude/
.adk/

# Python bytecode and build noise
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# E2E run traces and stdout: large, per-run, regenerated on every launch
e2e_*.jsonl
e2e_*.log
*.stdout.log
train_full.log
pilot_v*.log
v4_full.log

# Per-run research/execution graph state written by the runtime
graph_runs/

# Rasterised exports — regenerate from the committed .svg / .json
research_graph_*.png

# Run bundles dropped in for analysis (artefacts, checkpoints, traces)
CoScientist/track3/

# Paper and demo workspace — the article, its figures, LaTeX build products and
# the recorded bundles the replay plays. Kept out of the repository: they are
# artefacts of one submission, not part of the system.
paper/
demo/
RUNBOOK_*.md

# Per-run traces and exports dropped at the repository root
act3*.jsonl
act3*.log
act3*.json
act3*.html
act3*.svg
act3*.png
track3*
run_evolution.log
last_run.log
session.log
dataset_gen.log
agent_events.log
runs/
logs/
workspace/
tz_documents/
conversations*/
task_tracker_data.json
*_report.md

# Reference PDFs and vendored templates pulled in for the write-up
CoScientist/docs/*.pdf
CoScientist/golem_h1/
IEEE-conference-template-*/
